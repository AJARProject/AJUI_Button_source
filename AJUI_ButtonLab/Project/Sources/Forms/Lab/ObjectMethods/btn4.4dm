
Case of 
	: (Form event code=On Load)
		Form.btn4:=New AJUI_Button 
		Form.btn4.Name("btn4")
		
		  //default
		Form.btn4.BGColor(AJUI_btn_default;"#4388BB")
		Form.btn4.Label(AJUI_btn_default;"AJUI Button Lab")
		Form.btn4.FontColor(AJUI_btn_default;"white")
		Form.btn4.BorderSize(AJUI_btn_default;1)
		Form.btn4.BorderColor(AJUI_btn_default;"#3498DB")
		Form.btn4.PicturePath(AJUI_btn_default;"svg/si-glyph-dice-3.svg")
		
		
		
		
		
		
End case 


Form.btn4.Draw()