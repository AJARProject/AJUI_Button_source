# 4D project architecture
######################

/Data/*
/Logs/*
/Project/DerivedData/*
/Project/BuildSettings/*
# Settings/buildApp.4DSettings is versioned (4D 21 R4 component build settings)
/userPreferences*/*
/Builds/*
# component built by AJUI_Btn_buildComponent / BUILD APPLICATION
/Components/AJUI_Button.4dbase/
# created by 4D when the project is opened
/Resources/en.lproj/
Libraries/*

# Don't need the data file, indexes, symbols, or journal
*.4DD
*.4DIndx
*.4DIndy
*symbols.txt
*.journal
*.match

# dont need the 4d info component folder_reports
Folder_Reports

# *.4DSettings is no longer ignored: Settings/buildApp.4DSettings is versioned

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

